{
  "name": "biblio-checker",
  "version": "1.0.0",
  "private": true,
  "description": "Web app that lists which publications from a BibTeX bibliography are still missing from the UGent Academic Bibliography (biblio.ugent.be)",
  "author": "Ruben Taelman <rubensworks@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/rubensworks/biblio-checker#readme",
  "repository": "git@github.com:rubensworks/biblio-checker.git",
  "bugs": {
    "url": "https://github.com/rubensworks/biblio-checker/issues"
  },
  "keywords": [
    "bibtex",
    "biblio",
    "ugent",
    "publications"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "jest"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@rubensworks/eslint-config": "^3.1.0",
    "@types/jest": "^29.5.12",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "ts-jest": "^29.1.2",
    "typescript": "^7.0.0",
    "vite": "^5.2.0"
  }
}
